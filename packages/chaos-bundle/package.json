{
  "name": "@deepseek-ai/dsh-plugin-chaos",
  "description": "Chaos plugin bundle: mobile layout, remote login, restart, model controls, retry, think tags, and archived-session retention",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao2hang/dsh-plugin-chaos.git",
    "directory": "packages/chaos-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-plugin-chaos-auth": "workspace:^",
    "@deepseek-ai/dsh-plugin-chaos-janitor": "workspace:^",
    "@deepseek-ai/dsh-plugin-chaos-mobile": "workspace:^",
    "@deepseek-ai/dsh-plugin-chaos-models": "workspace:^",
    "@deepseek-ai/dsh-plugin-chaos-restart": "workspace:^",
    "@deepseek-ai/dsh-plugin-chaos-think-tags": "workspace:^",
    "@deepseek-ai/dsh-process-control": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness-chaos/vendor/cordis"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness-chaos/vendor/cordis",
    "tsdown": "^0.22.2"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "scripts/client-bundle.mjs"
  ]
}
