{
  "name": "@deepseek-ai/dsh-plugin-chaos-retry",
  "description": "Retry affordance for abnormally ended conversations: docked strip above the composer with a one-click resend of the last user message",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao2hang/dsh-plugin-chaos.git",
    "directory": "packages/chaos-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json && node ../chaos-bundle/scripts/client-bundle.mjs",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:/home/chaos/deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-attachment": "link:/home/chaos/deepseek-harness/packages/attachment/attachment",
    "@deepseek-ai/dsh-client-locale": "link:/home/chaos/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-test-runtime": "link:/home/chaos/deepseek-harness/packages/test-support/client-runtime",
    "@deepseek-ai/dsh-client-ui-approval": "link:/home/chaos/deepseek-harness/packages/client/ui-approval",
    "@deepseek-ai/dsh-client-ui-chat": "link:/home/chaos/deepseek-harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:/home/chaos/deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/home/chaos/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:/home/chaos/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:/home/chaos/deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/chaos/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-session": "link:/home/chaos/deepseek-harness/packages/core/session",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lightningcss": "^1.30.1",
    "tsdown": "^0.22.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
