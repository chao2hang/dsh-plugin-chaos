{
  "name": "@deepseek-ai/dsh-plugin-chaos-mobile",
  "description": "Mobile adaptation plugin for DeepSeek Harness Web GUI: drawer sidebar, touch-friendly input, bottom-sheet popups, viewport adaptation",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao2hang/dsh-plugin-chaos.git",
    "directory": "packages/chaos-mobile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json && node ../chaos-bundle/scripts/client-bundle.mjs",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness-chaos/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:/home/chaos/deepseek-harness-chaos/packages/api/session-controller",
    "@deepseek-ai/dsh-client-ui-conversation": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:/home/chaos/deepseek-harness-chaos/packages/host/webserver",
    "@deepseek-ai/dsh-token-meter": "link:/home/chaos/deepseek-harness-chaos/packages/llm/token-meter"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness-chaos/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:/home/chaos/deepseek-harness-chaos/packages/api/session-controller",
    "@deepseek-ai/dsh-client-ui-conversation": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:/home/chaos/deepseek-harness-chaos/packages/host/webserver",
    "@deepseek-ai/dsh-token-meter": "link:/home/chaos/deepseek-harness-chaos/packages/llm/token-meter",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lightningcss": "^1.30.1",
    "tsdown": "^0.22.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "highlight.js": "^11.12.0"
  }
}
