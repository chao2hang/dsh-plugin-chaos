    "@deepseek-ai/dsh-client-ui-settings": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:/home/chaos/deepseek-harness-chaos/packages/host/webserver",
    "@deepseek-ai/schemastery": "link:/home/chaos/deepseek-harness-chaos/vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness-chaos/vendor/cordis",
    "@deepseek-ai/dsh-host-webserver": "link:/home/chaos/deepseek-harness-chaos/packages/host/webserver",
    "@deepseek-ai/dsh-process-control": "link:../process-control",
    "@deepseek-ai/dsh-client-locale": "link:/home/chaos/deepseek-harness-chaos/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:/home/chaos/deepseek-harness-chaos/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-test-runtime": "link:/home/chaos/deepseek-harness-chaos/packages/test-support/client-runtime",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/schemastery": "link:/home/chaos/deepseek-harness-chaos/vendor/schemastery",
    "lightningcss": "^1.30.1",
    "tsdown": "^0.22.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
