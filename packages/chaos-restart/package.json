{
  "name": "@deepseek-ai/dsh-plugin-chaos-restart",
  "description": "Server self-restart plugin: process replacement RPC plus the System settings section with its confirmation flow",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao2hang/dsh-plugin-chaos.git",
    "directory": "packages/chaos-restart"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json && node ../chaos-bundle/scripts/client-bundle.mjs",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "link:/home/chaos/deepseek-harness-chaos/vendor/cordis",
